# Konfigurasi Database & Supabase Server
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Konfigurasi Keamanan & Rate Limiting Fungsi Aspirasi (FP-11)
ASPIRATION_RATE_LIMIT_MAX_PER_HOUR=5
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Konfigurasi Sumber Berita Eksternal (Opsional - Bagian 10 PRD)
PENS_NEWS_FEED_URL=https://www.pens.ac.id/feed/

